# Neon "direct" connection string (not the -pooler host). The driver prefix is
# rewritten to psycopg 3 automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/tarot?sslmode=require
# OAuth client ID (Web application) from Google Cloud Console. Public.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
ALLOWED_ORIGINS=http://localhost:5173
# SESSION_TTL_DAYS=30
